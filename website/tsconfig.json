{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "@docusaurus/module-type-aliases"]
  },
  "include": ["src", "docusaurus.config.ts", "sidebars.ts"],
  "exclude": ["build", ".docusaurus", "node_modules"]
}
